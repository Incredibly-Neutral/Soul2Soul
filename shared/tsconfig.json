{                                                                                                                              
    "compilerOptions": {                                                                                                         
      "target": "es2021",                                                                                                        
      "lib": ["ES2023", "ES2021", "DOM"],                                                                                                  
      "module": "commonjs",                                                                                                      
      "moduleResolution": "node",                                                                                                
      "esModuleInterop": true,                                                                                                   
      "forceConsistentCasingInFileNames": true,                                                                                  
      "strict": true,                                                                                                            
      "skipLibCheck": true,                                                                                                     
      "resolveJsonModule": true,                                                                                                 
      "useDefineForClassFields": true,                                                                                           
      "outDir": "./dist",                                                                                                        
      "rootDir": "./src",                                                                                                        
      "declaration": true,                                                                                                       
      "declarationMap": true                                                                                                     
    },                                                                                                                           
    "include": ["src/**/*"],                                                                                                     
    "exclude": ["node_modules", "dist"]                                                                                          
  }  