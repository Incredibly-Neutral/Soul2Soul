  {
    name: "anchorify",
    helper: (words: string) => {
      if (words !== undefined && words !== null && typeof words !== "object") {
        return words
          .toString()
          .replace(/(&nbsp;|<([^>]+)>)/gi, "")
          .toLowerCase()
