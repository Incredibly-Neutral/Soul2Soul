<file path="0xobsidian/src/filecoin/filecoin.ctrlr.ts">
/**
 * FilecoinController — upload/retrieve JSON objects via Filecoin
 * Onchain Cloud, using filecoin-pin's CAR builder for deterministic
 * IPFS Root CID ↔ Filecoin PieceCID matching.
 *
 * ## Pipeline
 *
 *   jsonBytes ──→ filecoin-pin CAR builder ──→ rootCid (IPFS, matches Kubo)
 *                                             └─→ carBytes ──→ Synapse upload ──→ pieceCid
 *
 * The rootCid uses the unixfs-v1-2025 profile (1 MiB chunks, raw leaves,
 * CIDv1, balanced layout) — the same spec Kubo applies with:
 *   ipfs config profile apply unixfs-v1-2025
 *
 * ## Two init modes (same as before)
 *   init()                  — author's own EOA pays
 *   initWithSessionKey()    — protocol payer pays via session key
 *
 * ## Upload results
 *   uploadJson(data) returns { rootCid, pieceCid, size, complete, copies }
 */

import { Synapse, mainnet, calibration, TOKENS } from "@filoz/synapse-sdk";
import * as SessionKey from "@filoz/synapse-core/session-key";
import { privateKeyToAccount } from "viem/accounts";
import { formatUnits, http, createWalletClient, custom } from "viem";
import type { Hex } from "viem";
import { IMainController } from "../main.ctrlr.js";
import { createCarFromPath } from "filecoin-pin/core/unixfs";
import { uploadToSynapse } from "filecoin-pin/core/upload";
import { mkdtempSync, writeFileSync, readFileSync, unlinkSync, rmSync } from "fs";
import { join } from "path";
import { tmpdir } from "os";
import { addJson } from "../ipfs/remotekubo.service.js";

// ── Types ───────────────────────────────────────────────────────────

export interface FilecoinBalance {
  raw: bigint;
  formatted: string;
  formattedUsdfc: string;
}

export interface FilecoinCosts {
  depositNeeded: bigint;
  perMonth: bigint;
  ready: boolean;
}

export interface FilecoinUploadResult {
  /** IPFS CID (unixfs-v1-2025 profile) — matches what Kubo produces. */
  rootCid: string;
  /** Filecoin PieceCID — used for on-chain deal audit. */
  pieceCid: string;
  /** Raw bytes uploaded (before padding). */
  size: number;
  /** True when all copies were stored + committed. */
  complete: boolean;
  /** Number of provider copies. */
  copyCount: number;
  /** Number of failed copy attempts. */
  failedCount: number;
  /** Per-copy info. */
  copies: Array<{ provider: string; dealId?: string }>;
}

export interface FilecoinSessionKeyData {
  sessionPrivateKey: string;
  sessionAddress: string;
  rootAddress: string;
  expiresAt: string;
  permissions: string[];
}

// ── Helpers ─────────────────────────────────────────────────────────

/** Minimal pino-compatible logger that delegates to console. */
const noopLogger = {
  info: (...args: any[]) => console.log("[filecoin]", ...args),
  warn: (...args: any[]) => console.warn("[filecoin]", ...args),
  error: (...args: any[]) => console.error("[filecoin]", ...args),
  debug: () => {},
  trace: () => {},
  fatal: (...args: any[]) => console.error("[filecoin:FATAL]", ...args),
  child: () => noopLogger,
  level: "info",
  silent: () => noopLogger,
  msgPrefix: "",
};

/**
 * Build a CAR file from raw bytes using filecoin-pin's UnixFS importer
 * (unixfs-v1-2025 profile). Returns the Root CID and the CAR bytes.
 */
async function buildCarFromBytes(bytes: Uint8Array): Promise<{
  rootCid: string;
  carBytes: Uint8Array;
}> {
  const tmpDir = mkdtempSync(join(tmpdir(), "s2s-fc-"));
  const jsonPath = join(tmpDir, "payload.json");
  writeFileSync(jsonPath, bytes);

  try {
    const { rootCid, carPath } = await createCarFromPath(jsonPath, {
      logger: noopLogger as any,
    });
    const carBytes = readFileSync(carPath);
    unlinkSync(carPath);
    return { rootCid: rootCid.toString(), carBytes };
  } finally {
    rmSync(tmpDir, { recursive: true, force: true });
  }
}

// ── Controller ──────────────────────────────────────────────────────

export class FilecoinController {
  private main: IMainController;
  private synapse: any;
  private initialized = false;
  private usingSessionKey = false;

  constructor(main: IMainController) {
    this.main = main;
  }

  async init(chain: "mainnet" | "calibration" = "mainnet"): Promise<void> {
    if (this.initialized) return;
    const pk = this.main.user?.private_key;
    if (!pk) throw new Error("FilecoinController.init: no active user with a private key");
    const chainConfig = chain === "mainnet" ? mainnet : calibration;
    this.synapse = Synapse.create({
      account: privateKeyToAccount(pk as Hex),
      source: "oxo-core",
      chain: chainConfig,
    });
    this.initialized = true;
  }

  async initWithSessionKey(
    skData: FilecoinSessionKeyData,
    rpcUrl: string,
    chain: "mainnet" | "calibration" = "mainnet",
  ): Promise<void> {
    if (this.initialized) return;
    const chainConfig = chain === "mainnet" ? mainnet : calibration;

    const sessionKey = SessionKey.fromSecp256k1({
      privateKey: skData.sessionPrivateKey as Hex,
      root: skData.rootAddress as Hex,
      chain: chainConfig,
      transport: http(rpcUrl),
    });
    await sessionKey.syncExpirations();

    const sessionSigner = privateKeyToAccount(skData.sessionPrivateKey as Hex);
    const fcTransport = custom({
      request: async ({ method, params }) => {
        if (method === "eth_signTypedData_v4") {
          const typedData = JSON.parse(params![1] as string);
          return await sessionSigner.signTypedData({
            domain: typedData.domain,
            types: typedData.types,
            message: typedData.message,
            primaryType: typedData.primaryType,
          });
        }
        const res = await fetch(rpcUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ jsonrpc: "2.0", method, params, id: 1 }),
        });
        const json = await res.json();
        if (json.error) throw new Error(json.error.message);
        return json.result;
      },
    });

    const client = createWalletClient({
      account: skData.rootAddress as Hex,
      chain: chainConfig,
      transport: fcTransport,
    });

    this.synapse = new Synapse({
      client,
      sessionClient: sessionKey.client,
      source: "oxo-core",
    });
    this.initialized = true;
    this.usingSessionKey = true;
    console.log("[filecoin] Initialised with session key → root:", skData.rootAddress);
  }

  // ── Upload / download ──────────────────────────────────────────

  /**
   * Upload JSON to Filecoin. Builds a CAR (unixfs-v1-2025 profile),
   * gets the Root CID (IPFS-compatible), uploads to Filecoin SPs,
   * and returns both the Root CID and PieceCID.
   */
  async uploadJson(data: unknown): Promise<FilecoinUploadResult> {
    this.ensureInit();

    const json = JSON.stringify(data, null, 2);
    const bytes = new TextEncoder().encode(json);

    // 1. Build CAR → get Root CID
    const { rootCid, carBytes } = await buildCarFromBytes(bytes);

    // 2. Upload the CAR to Filecoin SPs via filecoin-pin's uploader
    //    (which calls Synapse internally and attaches rootCid as piece metadata)
    const result = await uploadToSynapse(
      this.synapse,
      carBytes,
      rootCid as any,   // uploadToSynapse expects CID type from multiformats
      noopLogger as any,
    );
    return {
      rootCid,
      pieceCid: result.pieceCid.toString(),
      size: result.size,
      complete: result.complete,
      copyCount: result.copies?.length ?? 0,
      failedCount: result.failedAttempts?.length ?? 0,
      copies:
        result.copies?.map((c: any) => ({
          provider: c.providerId?.toString() ?? "unknown",
          dealId: c.dataSetId?.toString(),
        })) ?? [],
    };
  }

  /**
   * Upload the same bytes to a Kubo node (instant IPFS availability).
   * Must be called separately, but uses the exact same bytes as uploadJson
   * so the Root CID produced by both paths is identical.
   *
   * @param data    - Same data passed to uploadJson()
   * @param kuboUrl - Kubo RPC endpoint (e.g. "ipfs.transport-union.dev")
   * @returns The IPFS CID (should match uploadJson().rootCid)
   */
  async uploadToKubo(data: unknown, kuboUrl: string): Promise<string> {
    return addJson(data, kuboUrl);
  }

  /**
   * Retrieve a JSON object by PieceCID (via Filecoin SPs).
   */
  async retrieveJson(pieceCid: string): Promise<unknown> {
    this.ensureInit();
    const bytes: Uint8Array = await this.synapse.storage.download({ pieceCid });
    const text = new TextDecoder().decode(bytes);
    return JSON.parse(text);
  }

  async isRetrievable(pieceCid: string): Promise<boolean> {
    try {
      await this.synapse.storage.download({ pieceCid });
      return true;
    } catch {
      return false;
    }
  }

  // ── Internals ───────────────────────────────────────────────────

  private ensureInit(): void {
    if (!this.initialized) throw new Error("FilecoinController not initialised — call .init() or .initWithSessionKey() first");
  }
}
</file>

<file path="0xobsidian/src/keystore/keystore.ts">
/**
 * Keystore — Encryption-at-rest for author private keys.
 *
 * Implements Track A of `RFC-0xobsidian-identity-key-custody-1.md`:
 * the author `private_key` is encrypted before being written to disk,
 * decrypted only transiently in memory while signing.
 *
 * ## Architecture
 *
 * ```
 *      In-memory (plaintext)          On disk (blob, base64)
 *   ┌──────────────────────┐     ┌──────────────────────┐
 *   │  private_key: string │ ←──→│  key_blob: string    │
 *   │  (OXOUser in mem)    │     │  (settings.authors)  │
 *   └──────────────────────┘     └──────────────────────┘
 *              ↑ encrypt() / decrypt()
 *              │
 *         [SafeStorageKeystore]
 *         (Electron safeStorage)
 * ```
 *
 * The `Keystore` interface allows swapping implementations without touching
 * consumers. Currently only `SafeStorageKeystore` is implemented; the
 * factory returns the best available provider.
 *
 * ## Thread-safety
 *
 * `safeStorage` synchronizes internally — no locks needed from the plugin
 * side. Concurrent encrypt/decrypt calls are safe.
 */

import { runSpike } from "./spike.js";

// ── Interface ───────────────────────────────────────────────────────

export interface IKeystore {
  /** Encrypt a plaintext string. Returns base64-encoded encrypted blob. */
  encrypt(plaintext: string): string;

  /** Decrypt a base64-encoded blob back to plaintext. */
  decrypt(blob: string): string;

  /** Is the keystore actually usable right now? */
  isAvailable(): boolean;

  /** Human-readable name for diagnostics. */
  readonly name: string;
}

// ── SafeStorage Implementation (Electron) ───────────────────────────

/**
 * Wraps Electron's `safeStorage` API, which delegates to the OS-native
 * keystore (macOS Keychain, Windows DPAPI, Linux Secret Service).
 *
 * Must be constructed only after `isEncryptionAvailable()` has been
 * confirmed (see `createKeystore()`).
 */
export class SafeStorageKeystore implements IKeystore {
  readonly name = "SafeStorageKeystore (Electron safeStorage)";

  private safeStorage: any;

  constructor(safeStorage: any) {
    this.safeStorage = safeStorage;
  }

  encrypt(plaintext: string): string {
    const buf: Buffer = this.safeStorage.encryptString(plaintext);
    return buf.toString("base64");
  }

  decrypt(blob: string): string {
    const buf = Buffer.from(blob, "base64");
    return this.safeStorage.decryptString(buf);
  }

  isAvailable(): boolean {
    try {
      return !!this.safeStorage?.isEncryptionAvailable?.();
    } catch {
      return false;
    }
  }
}

// ── Fallback for when safeStorage is unreachable ─────────────────────

/**
 * Placeholder used when the spike determines `safeStorage` is not
 * reachable from the Obsidian plugin context. The RFC/Handoff specifies
 * `@napi-rs/keyring` as the designated fallback; implement it here when
 * that path is chosen.
 *
 * Until then, this implementation silently refuses (the factory returns
 * it only after the spike verdict says "unreachable" — a user action is
 * needed before the plugin will work).
 */
export class UnavailableKeystore implements IKeystore {
  readonly name = "UnavailableKeystore (no OS keystore available)";

  encrypt(_plaintext: string): string {
    throw new Error(
      "No OS keystore is available on this system. " +
        "Cannot encrypt private key. " +
        "See vault-plugin console for spike results.",
    );
  }

  decrypt(_blob: string): string {
    throw new Error(
      "No OS keystore is available on this system. " +
        "Cannot decrypt private key blob.",
    );
  }

  isAvailable(): boolean {
    return false;
  }
}

// ── /dev/null keystore (Linux degraded mode, A2) ────────────────────

/**
 * "Pass-through" keystore used on Linux when `safeStorage` is reachable
 * but `isEncryptionAvailable()` returns false (no Secret Service backend).
 *
 * This is the **explicit degraded mode** the RFC requires — it logs a
 * loud warning every time it is used, so the operator knows the key is
 * NOT encrypted at rest.
 *
 * Switch this to `SafeStorageKeystore` once a Secret Service backend
 * (e.g. `gnome-keyring` / `keepassxc`) is available.
 */
export class PlaintextKeystore implements IKeystore {
  readonly name = "PlaintextKeystore (⚠️ NO ENCRYPTION — degraded mode)";

  private warned = false;

  private warn() {
    if (this.warned) return;
    console.warn(
      "\x1b[33m%s\x1b[0m",
      "[oxo-core] " +
        "⚠️  WARNING: safeStorage is available but isEncryptionAvailable() " +
        "returned false (common on headless/minimal Linux — no Secret Service " +
        "backend). The private key will be stored as PLAINTEXT. Install a " +
        "Secret Service provider (e.g. gnome-keyring, keepassxc) and restart " +
        "Obsidian to enable encryption.",
    );
    this.warned = true;
  }

  encrypt(plaintext: string): string {
    this.warn();
    // Store as base64 of the plaintext — not actual encryption, but makes
    // the on-disk format indistinguishable from an encrypted blob so the
    // decrypt path doesn't need branching per implementation.
    return Buffer.from(plaintext, "utf-8").toString("base64");
  }

  decrypt(blob: string): string {
    this.warn();
    return Buffer.from(blob, "base64").toString("utf-8");
  }

  isAvailable(): boolean {
    return true; // Always "available" — it's just a no-op wrapper
  }
}

// ── Factory ─────────────────────────────────────────────────────────

export type KeystoreMode =
  | "safe-storage" // Electron safeStorage, encryption available
  | "degraded-linux" // safeStorage reachable but unavailable → pass-through
  | "unavailable"; // no safeStorage at all → plugin won't work without fallback

/**
 * Result of probing the environment for keystore availability.
 */
export interface KeystoreProbe {
  mode: KeystoreMode;
  keystore: IKeystore;
  detail: string;
}

/**
 * Probe the runtime and return the best available keystore.
 *
 * Effectively runs A0's spike logic and returns an `IKeystore` ready for
 * use. Call once at startup and cache the result.
 *
 * @returns A `KeystoreProbe` with the resolved keystore and a detail
 *   string for logging.
 */
export function probeKeystore(): KeystoreProbe {
  const spike = runSpike();

  if (!spike.electronFound || !spike.safeStorageFound) {
    return {
      mode: "unavailable",
      keystore: new UnavailableKeystore(),
      detail: spike.verdict,
    };
  }

  if (!spike.encryptionAvailable) {
    return {
      mode: "degraded-linux",
      keystore: new PlaintextKeystore(),
      detail:
        spike.verdict +
        " Using PlaintextKeystore (degraded) — key will not be encrypted.",
    };
  }

  // safeStorage is available — build the real keystore
  const electronRemote: any =
    (typeof require !== "undefined" &&
      (require("electron") as any)?.remote) ||
    (typeof require !== "undefined" && (require("@electron/remote") as any));

  const keystore = new SafeStorageKeystore(electronRemote.safeStorage);

  return {
    mode: "safe-storage",
    keystore,
    detail: spike.verdict,
  };
}

/**
 * Default singleton. Probed once at import time so the keystore is ready
 * for `saveSettings()` / `loadSettings()` on the first call.
 *
 * In the unlikely event that `electron` is not loaded when this module is
 * first imported (e.g., during a test run), the probe may return
 * "unavailable". Call `probeKeystore()` again later if needed.
 */
export const defaultKeystore: IKeystore = probeKeystore().keystore;
