    );
  });
});

// ============================================================================
// Single Action
// ============================================================================

describe('validateSingleInput', () => {
  it('parses a valid single input', () => {
    const result = validateSingleInput(validSingleInput);
    expect(result.job.id).toBe('lens-post-1');
    expect(result.signature).toBeTruthy();
  });

