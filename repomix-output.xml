import type { EthersContract } from '@/types';
import SafeAppsSDK from '@safe-global/safe-apps-sdk';
import { createPublicClient, http } from 'viem';
import { getProtocolInfo, S2SProtocolInfo } from '@s2s/soul2soul-shared/safe-app';
