import { fetchWithTimeout } from "./helpers";

interface StandardLink {
  Hash: { "/": string };
  Name: string;
  Tsize: number;
}

export interface DagNode {
  Links?: StandardLink[];
  metadata?: {
    [id: string]: {
      path: string;
      cid: string;
      updatedAt?: number;
    };
  };
}

export const getPublicationConfig = async (gateway: string, configCid: string) => {
  try {
    const response = await fetch(`${gateway}/api/v0/cat?arg=${configCid}`, {
      method: "POST",
    });
    if (!response.ok) {
      throw new Error(
        `Failed to fetch config from IPFS: ${response.statusText}`,
      );
    }
    const config = await response.json();
    if (!config || !config.mapping) {
      throw new Error("Invalid config format: missing mapping");
    }
    return config;
  } catch (error) {
    console.error("Error in getPublicationConfig:", error);
    throw error;
  }
  // });
};

export const uploadFile = async (gateway: string, output: string) => {
  const ipfsApiUrl = `${gateway}/api/v0/add`;
  const formData = new FormData();
  formData.append("file", output);

  const response = await fetch(ipfsApiUrl, {
    method: "POST",
    body: formData,
  });

  if (!response.ok) {
    throw new Error(
      `IPFS upload failed: ${response.status} ${response.statusText}`,
    );
