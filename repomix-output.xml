        .andThen(handleOperationWith(wallet))
        .andThen(client.waitForTransaction)
        .andThen((txHash) => fetchFeed(client, { txHash }));

        if (result.isErr()) {
            return console.error(result.error);
        }

        const f = result.value;

        if (f != null) {
            return f.address;
        }
    }
}
