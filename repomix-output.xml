				},
			}),
		),
	),
	paths: {
		sources: ['contracts/contracts'],
		artifacts: 'contracts/artifacts',
		cache: 'contracts/cache',
	},
	generateTypedArtifacts: {
		destinations: [
			{
				folder: './generated',
				mode: 'typescript',
			},
		],
	},
};

export default config;
