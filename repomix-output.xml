  {
    name: "sluggify",
    helper: (words: string) => {
      if (words !== undefined && words !== null && typeof words !== "object") {
        return words
          .toLowerCase()
          .replace(/[^a-zA-Z ]/g, "")
          .trim()
          .split(" ")
          .join("-");
      } else {
        return "fout in naam";
      }
    },
