import OxO from "./main.js";
import { IOXOUser, OXOUser } from "./user/user.js";
import { IpfsCtrlr, ipfsController } from "./ipfs/ipfs.ctrlr.js";;
import { PinataService } from "./ipfs/pinata.ctrlr.js";
import { LitService } from "@s2s/soul2soul-shared";
import { LensService } from "./lens/lens.ctrlr.js";
import { IPermissionlessSafeService, PermissionlessSafeService } from "./eth/permissionless.safe.service.js";
import { FilecoinController, FilecoinSessionKeyData } from "./filecoin/filecoin.ctrlr.js";
import { Notice } from "obsidian";
import { IWaapService, WaapService } from "./eth/waap.service.js";
import { readFileSync, existsSync } from "fs";
import { resolve } from "path";
import { ViemService } from "./eth/viem.service.js";
import { base } from "viem/chains";

// @ts-ignore
const basePath = (app.vault.adapter as any).basePath;

export interface IMainController {
  user: IOXOUser;
  basePath: string;
  env: { [key: string]: string | undefined };
  /** 4337 smart account per chain (PermissionlessSafeService). */
  account: { [key: string]: IPermissionlessSafeService };
  storage?: FilecoinController;
  safeInstance: any;
  ipfs: IpfsCtrlr;
  lit: any;
  lens: any;
  plugin: OxO;
  waap: IWaapService;
  init: () => Promise<void>;
  initChains: (chains: string[]) => Promise<boolean>;
  initChain: (chain: string) => Promise<void>;
  hasActiveUser: () => boolean;
  hasAccounts: () => string[];
  newAuthor: (name: string, type: string, privateKey?: string) => Promise<void>;
  toggleAuthor: (user: IOXOUser) => Promise<void>;
}

export class MainController implements IMainController {
  user!: IOXOUser;
  basePath: string;
  env!: { [key: string]: string | undefined };
  viem!: ViemService;
  account!: { [key: string]: IPermissionlessSafeService };
  storage?: FilecoinController;
  ipfs!: IpfsCtrlr;
  lit!: any;
  lens: any;
  pinata!: PinataService;
  plugin: OxO;
  waap!: IWaapService

  constructor(plugin: OxO) {
    this.basePath = basePath;
    this.ipfs = ipfsController;
    this.plugin = plugin;
  }

  async init() {

    this.account = {};
    this.pinata = new PinataService(this);
    this.lit = new LitService({ "environment": "prod"});
    this.viem = new ViemService(base, this.plugin.settings.rpc_key)
    this.lens = new LensService(this);
  
    const activeUser = this.plugin.settings.authors.find((a: any) => a.active);

    if (activeUser == undefined) {
      new Notice("no active 0xObsidian user", 3000)
    } else {
      const { name, active, private_key, eoa, safe } = activeUser;
      this.user = new OXOUser(name, active, private_key, eoa, safe);

      // if (!await this.user.checkLensProfile(this)) {
      //   console.log("hoi, nieuwe lens account")
      //   this.user.addLensAccount(this)
      // }
    }

    // ── Filecoin storage init ─────────────────────────────────────
    await this.initFilecoin();
  }

  /**
   * Load the session key from the plugin folder and initialise the
   * FilecoinController with it.
   */
  private async initFilecoin(): Promise<void> {
    // Plugin folimport { getPackedSettings } from "http2";der: {vault}/.obsidian/plugins/0xobsidian/
    const pluginDir = resolve(this.basePath, ".obsidian", "plugins", "0xobsidian");
    const skPath = resolve(pluginDir, "session-key.json");

    if (!existsSync(skPath)) {
      console.log("[filecoin] No session-key.json found — skipping Filecoin init");
      return;
    }

    try {
      const raw = readFileSync(skPath, "utf-8");
      const skData: FilecoinSessionKeyData = JSON.parse(raw);

      // Build the RPC URL from the DRPC key in settings
      const rpcKey = this.plugin.settings.rpc_key;
      const rpcUrl = rpcKey
        ? `https://lb.drpc.live/filecoin/${rpcKey}`
        : "https://api.node.glif.io/rpc/v1";

      this.storage = new FilecoinController(this);
      await this.storage.initWithSessionKey(skData, rpcUrl);

      new Notice(`📦 Filecoin storage ready — payer: ${skData.rootAddress}`, 4000);
    } catch (err: any) {
      console.error("[filecoin] Failed to init Filecoin storage:", err);
    }
  }

  hasActiveUser() {
    return this.user && this.user.private_key ? true : false;
  }

  hasAccounts() {
    return Object.keys(this.account)
  }

  async initChains(chains: string[]) {

    for (const chain of chains) {
      await this.initChain(chain);
    }

    return true;
  }

  async initChain(chain: string) {

      const chainName = chain; // preserve original name for lookup

      if (this.account[chain] == undefined) {
        this.account[chain] = new PermissionlessSafeService(this, chainName);
        await this.account[chain].updateSigner(this.user.private_key);

        // Connect to existing Safe if an address is stored, otherwise deploy fresh
        if (this.user.safe) {
          await this.account[chain].connectToExistingSafe(this.user.safe as `0x${string}`);
        } else {
          const salt = `s2s_${chainName}_${this.user.name}`;
          await this.account[chain].connectToFreshSafe(salt);
        }

        console.log("Safe address:", this.account[chain].address)
      }
  }

  async newAuthor(name: string, type: string, privateKey?: string) {

    this.user = new OXOUser(
      name,
      true,
      privateKey,       // use imported key if given, undefined = generate random
      undefined,
      undefined,
    );

    if (type === "safe") {

      if (this.hasAccounts().length < 1) {
        await this.initChains(['ETH_MAINNET','BASE'])
      } else {
        for (const chain of Object.keys(this.account)) {
          await this.account[chain].updateSigner(this.user.private_key);
        }
      }

      // Store the Safe address in the user's safe field
      this.user.safe = this.account["ETH_MAINNET"]?.address;
    }

   // this.user.lens = await this.user.addLensAccount(this)

    this.plugin.settings.authors.push(this.user);
    this.plugin.authorsTab.display();
    this.plugin.saveSettings();
  }

  async toggleAuthor(_user: IOXOUser) {
    this.user = new OXOUser(
      _user.name,
      _user.active,
      _user.private_key,
      _user.eoa,
      _user.safe,
    );

    for (const chain of Object.keys(this.account)) {
      this.account[chain].updateSigner(this.user.private_key);
    }

    this.lit.init();
  }

  safeInstance (chain: string) {
    return new PermissionlessSafeService(this, chain);
  }
}
</file>

<file path="neutralpress/src/main.ts">
import { IMainController, MainController } from "./main.ctrlr";

import {
	CachedMetadata,
	Editor,
	FileSystemAdapter,
	Plugin,
	TFile,
} from "obsidian";

import { DSGSettingsTab, DEFAULT_SETTINGS, Settings } from "./settings";
import { RevokeModal } from "./ui/revoke.modal"


export default class DSG extends Plugin {
	settings!: Settings;
	ctrlr!: IMainController;

	colourTags() {
		setTimeout(() => {
			document
				.querySelectorAll(".multi-select-pill")
				.forEach((el: any) => {
					const text = el.querySelector(
						".multi-select-pill-content span",
					)?.textContent;
					const svg: HTMLElement | null = el.querySelector(
						".multi-select-pill-remove-button svg",
					);

					if (text != null && text.startsWith("p--")) {
						el.style.backgroundColor = "#c5f7da";
						el.style.color = "#41634f";
					}
					if (svg != null) {
						svg.style.stroke = "#41634f";
					}
				});
		}, 500);
	}

	extractTags(meta: CachedMetadata | null): string[] {
		if (!meta || !meta.frontmatter) return [];
		const fm = meta.frontmatter;
		if (Array.isArray(fm.tags)) return fm.tags;
		if (typeof fm.tags === "string") return fm.tags.split(/,\s*/);
		return [];
	}

	getStreamID(meta: CachedMetadata | null): string {
		if (!meta || !meta.frontmatter) return "";
		const fm = meta.frontmatter;
		if (fm.stream_id) return fm.stream_id;
		return "";
	}


	async onload() {
		this.addSettingTab(new DSGSettingsTab(this.app, this));
		await this.loadSettings();

		this.ctrlr = new MainController(this);

		this.registerEvent(
			this.app.workspace.on("file-menu", (menu, file) => {
				const activeFile = this.app.workspace.getActiveFile() as TFile;

				menu.addItem((item) => {
					item.setTitle("Preview")
						.setIcon("document")
						.onClick(() => this.ctrlr.proposeContent(activeFile, false));
				});
			}),
		);

		this.registerEvent(
			this.app.workspace.on("file-menu", (menu, file) => {
				menu.addItem((item) => {
					item.setTitle("Propose to print")
						.setIcon("document")
						.onClick(() => this.ctrlr.proposeContent(file, true));
				});
			}),
		);

		this.registerEvent(
			this.app.workspace.on("file-open", () => {
				this.colourTags();
			}),
		);

		this.registerEvent(
			this.app.vault.on("modify", async (file: TFile) => {
				if (file.extension !== "md") return;

				this.colourTags();

				const cachedMeta = this.app.metadataCache.getFileCache(file);
				const previousTags = this.extractTags(cachedMeta);

				// Wait for next tick for updated metadata
				setTimeout(async () => {
					const updatedMeta =
						this.app.metadataCache.getFileCache(file);
					const newTags = this.extractTags(updatedMeta);

					const added = newTags.filter(
						(t) => !previousTags.includes(t),
					);
					const removed = previousTags.filter(
						(t) => !newTags.includes(t),
					);

					if (added.length > 0) {
						if (added[0].endsWith("--s2s")) {
							console.log("Web tag added:", added[0]);
							await this.ctrlr.newPublication(added[0], file);
						}
					} else if (removed.length > 0) {
						if (removed[0].endsWith("--s2s")) {
							console.log("Web tag removed:", removed[0]);
							const contentId = this.getStreamID(updatedMeta) /// ????
							const ensName = removed[0].toLowerCase().replace("--s2s", "") + ".soul2soul.eth";
							const subdomain = ensName.split(".")[0]
							const onSubmit = async () => {
								await this.ctrlr.content.publishContent(file, subdomain);
								await this.ctrlr.revokeLicense(subdomain, file);
								// Read the signed_id from frontmatter after re-signing
								const { contentId } = await this.ctrlr.content.parseNote(file);
								await this.ctrlr.renderCalls(ensName, [contentId ?? subdomain], this.ctrlr.oxo.settings.litUsageKey, true)
							}
							return new RevokeModal(this.app, this.ctrlr, ensName, onSubmit).open();
							
						}
					}
				}, 100); // short delay to let metadataCache update
			}),
		);

		this.addCommand({
			id: "publish",
			name: "publish",
			callback: () => {
				const activeFile = this.app.workspace.getActiveFile() as TFile;
				return this.ctrlr.proposeContent(activeFile, true);
			},
		});
	}

	onunload() {}

	async loadSettings() {
		this.settings = Object.assign(
			{},
			DEFAULT_SETTINGS,
			await this.loadData(),
		);
	}

	async saveSettings() {
		await this.saveData(this.settings);
	}
}
</file>

<file path="protocol/actions/src/prep/main.ts">
import { ActionResult, PrepData, PrepInput, S2SBody, S2SJob, S2STemplateConfig } from "@s2s/soul2soul-shared/lit-actions";
import { getDomainOwnerAndModules } from "../libs/ens.factory";
import { fetchById, fetchByQuery } from "../libs/lens.factory";
import { getConfig, getTaskConfig } from "../single/config.ctrl";
import { requireFields } from "../libs/helpers";

const ACTION = "prep";

async function main(input: PrepInput): Promise<ActionResult<PrepData>> {

  let trace: any[] = [];

  try {
    requireFields(input, ["publication", "contentIds"]);          // configCid is optional
    const { publication, configCid, contentIds } = input;
    if (!Array.isArray(contentIds) || contentIds.length === 0)
      throw "contentIds must be a non-empty array";

    const { multisig, configModule, publicationModule } =
      await getDomainOwnerAndModules(publication);
    if (!multisig || !configModule || !publicationModule)
      throw `modules not found for '${publication}' (multisig/config/publication)`;

    const config = await getConfig(configCid, configModule);
    const jobs: S2SJob[] = [];

    for (const contentId of contentIds) {
      const body: S2SBody | null | undefined = await fetchById(contentId);
      if (!body?.id) throw `content not found: '${contentId}'`;

      const { templateConfig, rippleConfigs } = await getTaskConfig(config, body);
      jobs.push({ id: body.id, templateConfig, templateData: undefined, html: "" });

      // ripples = cascade re-renders; only expand for a single primary content id
      if (contentIds.length === 1) {
        for (const rippleConfig of rippleConfigs) {
          const rippleTemplateConfig: S2STemplateConfig | undefined =
            config.mapping.templateConfig.find(
              (m: S2STemplateConfig) => m.reference === rippleConfig.destination);
          if (!rippleTemplateConfig)
            throw `ripple destination '${rippleConfig.destination}' not in mapping.templateConfig`;

          const ripples = await fetchByQuery(rippleConfig.query.method, rippleConfig.query.args);
          for (const ripple of ripples)
            if (ripple?.id)
              jobs.push({ id: ripple.id, templateConfig: rippleTemplateConfig,
                          templateData: undefined, html: "" });
        }
      }
    }

    // dedup by id, first occurrence wins
    const seen = new Set<string>();
    const uniqueJobs: S2SJob[] = [];
    for (const job of jobs) {
      if (seen.has(job.id)) continue;
      seen.add(job.id);
      uniqueJobs.push(job);
    }

    return { ok: true, action: ACTION, data: { jobs: uniqueJobs }, trace };
  } catch (e) {
    return { ok: false, action: ACTION,
             error: typeof e === "string" ? e : (e as Error)?.message ?? String(e), trace };
  }
}
