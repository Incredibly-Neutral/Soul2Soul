<file path="protocol/serverless/README.md">
# s2s Serverless Lit-action Runner

Bun-based Lit-action runner — fetches JS from IPFS by CID, injects ethers@5 + polyfills, executes securely in a sandboxed container.

## Architecture

| File | Purpose |
|---|---|
| `server.ts` | Bun HTTP server (Hono framework) |
| `Dockerfile` | Docker build |
| `docker-compose.yml` | Local Docker Compose |
| `.env.example` | Environment variables |

## Key Features

- Fetches and executes any JavaScript action stored on IPFS by CID
- LRU cache (50 entries) for repeated action code fetches
- Injects ethers@5 as a global (no signing capabilities)
- Lit Actions shim (`Lit.Actions.*`) for compatibility
- Bun runtime — fast, no npm
- Explicit permission flags for sandboxing

## Ports

| Port | Service |
|---|---|
| `4269` | HTTP API |

## Endpoints

| Method | Endpoint | Purpose |
|---|---|---|
| `POST` | `/run` | Execute an action |
| `GET` | `/actions/:cid` | Fetch action code from IPFS |
| `GET` | `/ipfs/:cid` | Raw IPFS cat |
| `GET` | `/health` | Uptime check |

## Usage

### cURL

```bash
curl -X POST http://localhost:4269/run \
  -H "Content-Type: application/json" \
  -d '{
    "cid": "Qm...action...",
    "inputs": { "publication": "foo.bar.eth", "configCid": "Qm..." }
  }'
```

### TypeScript (via `fetch` + `globalThis.ethers`)

```typescript
interface ActionRunParams {
  cid?: string;
  code?: string;       // or inline code instead of cid
  inputs: Record<string, unknown>;
}

interface ActionRunResult {
  success: boolean;
  result?: Record<string, unknown>;
  error?: string;
}

async function runAction(params: ActionRunParams): Promise<ActionRunResult> {
  const res = await fetch("http://localhost:4269/run", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(params),
  });

  return res.json();
}

// Example 1 — fetch action from IPFS
const res1 = await runAction({
  cid: "QmXyz123...abc",
  inputs: {
    publication: "foo.bar.eth",
    configCid: "QmConfig456...",
  },
});

// Example 2 — inline code (for prototyping)
const res2 = await runAction({
  code: `
    async function main(inputs) {
      const addr = "0x1234...";
      const signer = new ethers.Wallet(inputs.privateKey);
      return { addr, chainId: signer.provider?.network?.chainId };
    }
  `,
  inputs: { privateKey: "0xabc..." },
});
```

### TypeScript (via `Deno` / `Bun` — same server)

```typescript
// client.ts — run a stored action
import { runAction } from "./client";

const result = await runAction({
  cid: "QmPrepAction001...",
  inputs: {
    protocolInfo: { chainId: 8453 },
    authorSafeAddress: "0xa1b2...",
    publication: "alice.soul2soul.eth",
    configCid: "QmConfig789...",
    contentIds: ["QmPost001...", "QmPost002..."],
  },
});

console.log(result.result?.jobs); // [{ id, templateConfig, templateData, html }, ...]
```

### curl — fetch action code only

```bash
curl http://localhost:4269/actions/QmPrepAction001...
# → { "cid": "QmPrepAction001...", "code": "async function main...", "fetched": true }
```

### curl — health check

```bash
curl http://localhost:4269/health
# → { "status": "ok", "uptime": 142.3 }
```

## Docker / Docker Compose

```bash
# Build + run
docker build -s2s/serverless:latest .
docker run -p 4269:4269 s2s/serverless:latest

# Or via docker-compose
docker compose up --build
```

## Environment Variables

| Variable | Default | Description |
|---|---|---|
| `PORT` | `4269` | HTTP server port |
| `IPFS_GATEWAY` | `https://neutralpress.mypinata.cloud` | IPFS Pinata gateway (URLs: `{IPFS_GATEWAY}/ipfs/{cid}`) |
| `ACTION_TIMEOUT_MS` | `30000` | Max execution time per action (ms) |
</file>

<file path="protocol/serverless/server.js">
import { createServer } from "node:http";
import { execFile } from "node:child_process";
import { writeFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

// ─── Config ──────────────────────────────────────────────
const IPFS_GATEWAY = process.env.IPFS_GATEWAY || "https://ipfs.transport-union.dev";
const ACTION_TIMEOUT_MS = parseInt(process.env.ACTION_TIMEOUT_MS || "30000", 10);
const PORT = parseInt(process.env.PORT || "3000", 10);

// ─── Helpers ─────────────────────────────────────────
const runTempScript = (code, timeout) =>
  new Promise((resolve, reject) => {
    const tmpFile = join(tmpdir(), `s2s-action-${Date.now()}-${Math.random().toString(36).slice(2)}.cjs`);

    writeFileSync(tmpFile, code, "utf8");

    const child = execFile(
      "node",
      [tmpFile],
      { timeout, maxBuffer: 1024 * 1024 * 10, env: { ...process.env } },
      (err, stdout, stderr) => {
        try { rmSync(tmpFile); } catch {}
        if (err) return reject(err);
        resolve({ stdout: stdout.toString(), stderr: stderr.toString() });
      }
    );
    child.on("error", reject);
  });

// ─── IPFS fetch ──────────────────────────────────
async function fetchFromIPFS(cid) {
  const cleanCid = cid.replace(/^\/ipfs\//, "").replace(/^\/ipns\//, "");
  const url = `${IPFS_GATEWAY}/api/v0/cat?arg=${cleanCid}`;
  const res = await fetch(url, { method: "POST", signal: AbortSignal.timeout(15000) });
  if (!res.ok) throw new Error(`IPFS cat failed: ${res.status} ${res.statusText}`);
  return await res.text();
}

// ─── Build execution script ──────────────────────
function buildScript(userCode, inputs) {
  // Inject globals + action code, then call main(inputs)
  return `
    // ═══ Polyfills ═══
    const { Buffer } = require("buffer");
    globalThis.Buffer = Buffer;
    if (!globalThis.process) {
      globalThis.process = { env: { NODE_ENV: "production", BROWSER: "true" } };
    }
    globalThis.crypto = globalThis.crypto || await import("crypto").then(c => c.webcrypto);

    // ═══ ethers@5 global ═══
    globalThis.ethers = require("ethers");

    // ═══ Lit Actions shim (no signing) ═══
    const secretData = Buffer.from("{}","utf8");
    globalThis.Lit = {
      Actions: {
        set: () => {},
        readSecretData: () => secretData,
        getPrimaryKey: () => Buffer.from("00000000","hex"),
        setPublicKey: () => {},
        signEthereum: () => Promise.reject("signing disabled in serverless mode"),
        getPrivateKey: () => Promise.reject("key management disabled in serverless mode"),
      }
    };

    // ═══ User code ═══
    ${userCode}

    // ═══ Run main() if defined ═══
    (async () => {
      if (typeof main !== "function") return { status: "no main function defined" };
      return await main(${JSON.stringify(inputs)});
    })()
    .then(result => console.log(JSON.stringify({ result })))
    .catch(err => console.error(JSON.stringify({ error: err.message, stack: err.stack || "N/A" })));
  `;
}

// ════════════════════════════════════════════════════════
// ─── SERVER ─────────────────────────────────────────
// ════════════════════════════════════════════════════════
const server = createServer(async (req, res) => {
  res.setHeader("Content-Type", "application/json");
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET,POST,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.method === "OPTIONS") { res.writeHead(204); return res.end(); }

  // ═── Health ──
  if (req.method === "GET" && req.url === "/health") {
    res.writeHead(200);
    return res.end(JSON.stringify({ status: "ok", uptime: process.uptime() }));
  }

  // ═── GET /actions/:cid — fetch action code from IPFS ──
  if (req.method === "GET" && /^\/actions\/.+$/.test(req.url)) {
    const cid = req.url.replace("/actions/", "");
    try {
      const code = await fetchFromIPFS(cid);
      res.writeHead(200);
      return res.end(JSON.stringify({ cid, code, fetched: true }));
    } catch (err) {
      res.writeHead(502);
      return res.end(JSON.stringify({ error: `IPFS fetch failed: ${err.message}` }));
    }
  }

  // ═── GET /ipfs/:cid — raw IPFS cat ──
  if (req.method === "GET" && /^\/ipfs\/.+$/.test(req.url)) {
    const cid = req.url.replace("/ipfs/", "");
    try {
      const text = await fetchFromIPFS(cid);
      res.writeHead(200);
      return res.end(text);
    } catch (err) {
      res.writeHead(502);
      return res.end(JSON.stringify({ error: err.message }));
    }
  }

  // ═── POST /run — execute an action ──
  if (req.method === "POST" && req.url === "/run") {
    const chunks = [];
    for await (const chunk of req) chunks.push(chunk);
    let body;
    try { body = JSON.parse(Buffer.concat(chunks).toString()); }
    catch {
      res.writeHead(400);
      return res.end(JSON.stringify({ error: "invalid JSON" }));
    }

    let code;
    if (body.code) {
      code = body.code;
    } else if (body.cid) {
      code = await fetchFromIPFS(body.cid);
    } else {
      res.writeHead(400);
      return res.end(JSON.stringify({ error: 'provide "code" or "cid"' }));
    }

    const inputs = body.inputs || {};

    try {
      const fullScript = buildScript(code, inputs);
      const result = await runTempScript(fullScript, ACTION_TIMEOUT_MS);

      // Parse the JSON result from stdout
      let parsed = { status: "raw output" };
      for (const line of (result.stdout || "").split("\n").filter(Boolean)) {
        try {
          parsed = JSON.parse(line);
          break;
        } catch { /* skip */ }
      }

      res.writeHead(200);
      return res.end(JSON.stringify({
        success: true,
        ...parsed,
        logs: { stdout: result.stdout, stderr: result.stderr },
      }));
    } catch (err) {
      res.writeHead(500);
      return res.end(JSON.stringify({
        success: false,
        error: err.message,
        code: err.code,
      }));
    }
  }

  res.writeHead(404);
  return res.end(JSON.stringify({ error: "not found" }));
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("\n  🚀 s2s Lit-action runner");
  console.log("  ─────────────────────────");
  console.log(`  🌐  PORT:       ${PORT}`);
  console.log(`  📡 IPFS GW:     ${IPFS_GATEWAY}`);
  console.log(`  ⏱  TIMEOUT:    ${ACTION_TIMEOUT_MS}ms`);
  console.log("  ─────────────────────────");
  console.log("  Endpoints:");
  console.log("  POST /run              — run action  (body: { cid|code, inputs })");
  console.log("  GET  /actions/:cid     — fetch action code from IPFS");
  console.log("  GET  /ipfs/:cid        — raw IPFS cat");
  console.log("  GET  /health           — uptime check");
  console.log("\n  Example:");
  console.log("    curl -X POST http://localhost:${PORT}/run \\");
  console.log("      -H 'Content-Type: application/json' \\");
  console.log("      -d '{\"cid\":\"<IPFS_CID>\", \"inputs\":{\"publication\":\"foo.bar.eth\",\"configCid\":\"Qm...\"}}'");
  console.log("\n");
});
