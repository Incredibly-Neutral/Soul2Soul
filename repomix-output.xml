<file path="protocol/contracts/scripts/__verify-publication-contracts.ts">
/**
 * Verify deployed contracts on BaseScan via their API.
 *
 * Reads the compiled artifact for each contract and submits it
 * for verification. Run after deployment.
 *
 * Usage:
 *   npx tsx contracts/scripts/verify-contracts.ts
 *
 * Requires BASESCAN_API_KEY in the root .env. The deployed
 * addresses are hardcoded below — update them on each deploy.
 */

import { readFileSync, existsSync } from 'fs';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';
import { config } from 'dotenv';

config({ path: resolve(process.cwd(), '../.env') });

const __dirname = dirname(fileURLToPath(import.meta.url));

interface ContractToVerify {
  name: string;
  address: string;
  file: string; // relative path from artifact root
}

const CONTRACTS: ContractToVerify[] = [
  {
    name: 'S2SPublicationModuleV2',
    address: '0xbae8877eaeec61f4c443bff04e42bd04fc9b6a73',
    file: 'contracts/contracts/S2SPublicationModuleV2.sol/S2SPublicationModuleV2.json',
  },
  {
    name: 'S2SPublicationModuleV2Factory',
    address: '0xe948735151c43183accd8e85b992952b2711d554',
    file: 'contracts/contracts/S2SPublicationModuleV2Factory.sol/S2SPublicationModuleV2Factory.json',
  },
];

const BASESCAN_API = 'https://api.basescan.org/api';

async function verifyContract(contract: ContractToVerify, apiKey: string) {
  const artifactPath = resolve(__dirname, '../artifacts', contract.file);
  if (!existsSync(artifactPath)) {
    console.error(`  ❌ Artifact not found: ${artifactPath}`);
    console.error('     Run pnpm compile first.');
    return false;
  }

  const artifact = JSON.parse(readFileSync(artifactPath, 'utf-8'));

  // Build the standard-json-input format that BaseScan expects
  const metadata = artifact.metadata;
  const sources: Record<string, { content: string }> = {};
  for (const [path, info] of Object.entries(metadata.sources)) {
    sources[path] = { content: (info as any).content };
  }

  const standardJsonInput = JSON.stringify({
    language: 'Solidity',
    sources,
    settings: {
      optimizer: { enabled: true, runs: 200 },
      viaIR: true,
      evmVersion: 'shanghai',
      metadata: { bytecodeHash: 'none' },
    },
  });

  const body = new URLSearchParams({
    module: 'contract',
    action: 'verifysourcecode',
    contractaddresses: contract.address,
    sourceCode: standardJsonInput,
    codeformat: 'solidity-standard-json-input',
    contractname: contract.name,
    compilerversion: `v${metadata.compiler.version}`,
    constructorArguements: '',
    apikey: apiKey,
  });

  console.log(`  Submitting ${contract.name} (${contract.address})...`);

  try {
    const res = await fetch(BASESCAN_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    });
    const json = await res.json() as any;

    if (json.status === '1') {
      console.log(`  ✅ ${contract.name} submitted — GUID: ${json.result}`);
      console.log(`     Check status: ${BASESCAN_API}?module=contract&action=checkverifystatus&guid=${json.result}&apikey=${apiKey}`);
      return true;
    } else {
      console.error(`  ❌ ${contract.name}: ${json.result}`);
      return false;
    }
  } catch (err) {
    console.error(`  ❌ ${contract.name}: Network error — ${err}`);
    return false;
  }
}

async function main() {
  const apiKey = process.env.BASESCAN_API_KEY || process.env.ETHERSCAN_API_KEY;
  if (!apiKey) {
    console.error('❌ BASESCAN_API_KEY not set in .env');
    process.exit(1);
  }

  console.log(`Verifying ${CONTRACTS.length} contracts on BaseScan...\n`);

  let ok = 0;
  let fail = 0;
  for (const contract of CONTRACTS) {
    if (await verifyContract(contract, apiKey)) {
      ok++;
    } else {
      fail++;
    }
  }

  console.log(`\nDone — ${ok} verified, ${fail} failed.`);
  process.exit(fail > 0 ? 1 : 0);
}

main().catch((err) => {
  console.error('Fatal:', err);
  process.exit(1);
});
</file>

<file path="protocol/contracts/scripts/deploy-publication-factory.ts">
/**
 * Deploy S2SPublicationModuleV2 + S2SPublicationModuleV2Factory.
 *
 * Two-step: deploy the implementation first, then the factory which
 * accepts the impl address as a constructor argument. This keeps the
 * factory bytecode small enough to fit within contract size limits.
 *
 * Usage:
 *   cd protocol && npx tsx contracts/scripts/deploy-v2-factory.ts
 *
 * Set PUBLICATION_FACTORY_V2_ADDRESS in .env after deploying.
 */

import { createWalletClient, http } from 'viem';
import { privateKeyToAccount } from 'viem/accounts';
import { base } from 'viem/chains';
import { readFileSync, existsSync } from 'fs';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';
import { config } from 'dotenv';

config({ path: resolve(process.cwd(), '../.env') });

const __dirname = dirname(fileURLToPath(import.meta.url));
const artifactDir = resolve(__dirname, '../artifacts/contracts/contracts');

async function deployContract(client: ReturnType<typeof createWalletClient>, name: string, args: any[], rpcUrl: string): Promise<string> {
  const artifactPath = resolve(artifactDir, `${name}.sol/${name}.json`);
  if (!existsSync(artifactPath)) {
    console.error(`❌ Artifact not found at ${artifactPath}`);
    process.exit(1);
  }
  const artifact = JSON.parse(readFileSync(artifactPath, 'utf-8'));

  const hash = await client.deployContract({
    abi: artifact.abi,
    bytecode: artifact.bytecode as `0x${string}`,
    args,
    gas: 3_000_000n,
  });

  console.log(`   Deploy tx: ${hash}`);

  // Poll for receipt
  for (let i = 0; i < 30; i++) {
    const receipt = await fetch(rpcUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        jsonrpc: '2.0', method: 'eth_getTransactionReceipt',
        params: [hash], id: 1,
      }),
    }).then(r => r.json());

    if (receipt?.result?.contractAddress) {
      return receipt.result.contractAddress;
    }
    await new Promise(r => setTimeout(r, 2000));
  }

  console.error('❌ Timed out waiting for deploy receipt');
  process.exit(1);
}

async function main() {
  const pk = process.env.PROTOCOL_PRIVATE_KEY;
  if (!pk) { console.error('❌ PROTOCOL_PRIVATE_KEY not set'); process.exit(1); }

  // The publication module is a Safe module on Base — always deploy to Base
  const rpcUrl = process.env.VITE_DRPC_API_KEY
      ? `https://lb.drpc.live/base/${process.env.VITE_DRPC_API_KEY}`
      : 'https://mainnet.base.org';

  const payerHex = (pk.startsWith('0x') ? pk : `0x${pk}`) as `0x${string}`;
  const account = privateKeyToAccount(payerHex);
  const client = createWalletClient({ account, chain: base, transport: http(rpcUrl) });

  console.log(`Deploying from ${account.address}\n   Network: ${rpcUrl}\n`);

  // Step 1: deploy implementation
  console.log('1/2 Deploying S2SPublicationModule...');
  const impl = await deployContract(client, 'S2SPublicationModule', [], rpcUrl);
  console.log(`   ✅ Implementation at ${impl}\n`);

  // Step 2: deploy factory with implementation address
  console.log('2/2 Deploying S2SPublicationModuleFactory...');
  const factory = await deployContract(client, 'S2SPublicationModuleFactory', [impl], rpcUrl);
  console.log(`   ✅ Factory at ${factory}\n`);

  console.log(`Set in .env:\n`);
  console.log(`  PUBLICATION_FACTORY_V2_ADDRESS=${factory}`);
}

main().catch((err) => {
  console.error('Deploy failed:', err);
  process.exit(1);
});
</file>

