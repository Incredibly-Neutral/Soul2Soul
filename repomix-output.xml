// SPDX-License-Identifier: MIT
pragma solidity ^0.8.19;

/**
 * @title IS2SRecordsModule
 * @notice Interface for the S2S Records Module
 */
interface IS2SRecordsModule {
    // Events
    event RecordSet(string indexed key, string value);
    event RecordsSetBatch(string[] keys, string[] values);
    event RecordDeleted(string indexed key);
    
    // Errors
    error OnlySafe();
    error ArrayLengthMismatch();
    error EmptyKey();
    error KeyNotFound();
    
    // View functions
    function NAME() external view returns (string memory);
    function VERSION() external view returns (string memory);
    function safe() external view returns (address);
    
    // Write functions
    function setRecord(string calldata key, string calldata value) external;
    function setRecords(string[] calldata keys, string[] calldata values) external;
    function deleteRecord(string calldata key) external;
    
    // Read functions
    function getRecord(string calldata key) external view returns (string memory value);
    function getRecords(string[] calldata keys) external view returns (string[] memory values);
    function recordExists(string calldata key) external view returns (bool exists);
    
    // Enumeration functions
    function getAllKeys() external view returns (string[] memory);
    function getAllRecords() external view returns (string[] memory keys, string[] memory values);
    function getRecordCount() external view returns (uint256);
    function getKeyAtIndex(uint256 index) external view returns (string memory);
    
    // Interface support
    function supportsInterface(bytes4 interfaceId) external pure returns (bool);
}

/**
 * @title S2SRecordsModule
 * @notice A Safe module that allows storing and retrieving string-string key-value records
 * @dev Only the associated Safe can modify records
 */
contract S2SRecordsModule is IS2SRecordsModule {
    string public constant NAME = "S2S Records Module";
    string public constant VERSION = "1.1.0"; // Updated version
    
    // The Safe that owns this module instance
    address public immutable safe;
    
    // Storage for string-string records
    mapping(string => string) private records;
    
    // Array to track all keys for enumeration
    string[] private recordKeys;
    
    // Mapping to track if a key exists and its index in the array
    mapping(string => uint256) private keyIndex;
    mapping(string => bool) private keyExists;
    
    modifier onlySafe() {
        if (msg.sender != safe) revert OnlySafe();
        _;
    }
    
    constructor(address _safe) {
        require(_safe != address(0), "Invalid safe address");
        safe = _safe;
    }
    
    /**
     * @notice Set a single record
     * @param key The key for the record
     * @param value The value for the record
     */
    function setRecord(string calldata key, string calldata value) external onlySafe {
        if (bytes(key).length == 0) revert EmptyKey();
        
        // If this is a new key, add it to our tracking
        if (!keyExists[key]) {
            recordKeys.push(key);
            keyIndex[key] = recordKeys.length - 1;
            keyExists[key] = true;
        }
        
        records[key] = value;
        emit RecordSet(key, value);
    }
    
    /**
     * @notice Set multiple records in a single transaction
     * @param keys Array of keys
     * @param values Array of values
     */
    function setRecords(
        string[] calldata keys, 
        string[] calldata values
    ) external onlySafe {
        if (keys.length != values.length) revert ArrayLengthMismatch();
        
        for (uint256 i = 0; i < keys.length; i++) {
            if (bytes(keys[i]).length == 0) revert EmptyKey();
            
            // If this is a new key, add it to our tracking
            if (!keyExists[keys[i]]) {
                recordKeys.push(keys[i]);
                keyIndex[keys[i]] = recordKeys.length - 1;
                keyExists[keys[i]] = true;
            }
            
            records[keys[i]] = values[i];
        }
        
        emit RecordsSetBatch(keys, values);
    }
    
    /**
     * @notice Delete a record
     * @param key The key to delete
     */
    function deleteRecord(string calldata key) external onlySafe {
        if (!keyExists[key]) revert KeyNotFound();
        
        // Remove from records mapping
        delete records[key];
        
        // Remove from tracking arrays (swap with last element and pop)
        uint256 indexToDelete = keyIndex[key];
        uint256 lastIndex = recordKeys.length - 1;
        
        if (indexToDelete != lastIndex) {
            string memory lastKey = recordKeys[lastIndex];
            recordKeys[indexToDelete] = lastKey;
            keyIndex[lastKey] = indexToDelete;
        }
        
        recordKeys.pop();
        delete keyIndex[key];
        keyExists[key] = false;
        
        emit RecordDeleted(key);
    }
    
    /**
     * @notice Get a single record
     * @param key The key to look up
     * @return value The value associated with the key
     */
    function getRecord(string calldata key) external view returns (string memory value) {
        return records[key];
    }
    
    /**
     * @notice Get multiple records
     * @param keys Array of keys to look up
     * @return values Array of values corresponding to the keys
     */
    function getRecords(string[] calldata keys) external view returns (string[] memory values) {
        values = new string[](keys.length);
        for (uint256 i = 0; i < keys.length; i++) {
            values[i] = records[keys[i]];
        }
        return values;
    }
    
    /**
     * @notice Check if a record exists (has been set, even if empty)
     * @param key The key to check
     * @return exists True if the record key exists
     */
    function recordExists(string calldata key) external view returns (bool exists) {
        return keyExists[key];
    }
    
    /**
     * @notice Get all record keys
     * @return Array of all keys that have been set
     */
    function getAllKeys() external view returns (string[] memory) {
        return recordKeys;
    }
    
    /**
     * @notice Get all records (keys and values)
     * @return keys Array of all keys
     * @return values Array of corresponding values
     */
    function getAllRecords() external view returns (string[] memory keys, string[] memory values) {
        keys = recordKeys;
        values = new string[](recordKeys.length);
        
        for (uint256 i = 0; i < recordKeys.length; i++) {
            values[i] = records[recordKeys[i]];
        }
        
        return (keys, values);
    }
    
    /**
     * @notice Get the total number of records
     * @return count Number of records stored
     */
    function getRecordCount() external view returns (uint256) {
        return recordKeys.length;
    }
    
    /**
     * @notice Get the key at a specific index
     * @param index The index to query
     * @return key The key at the given index
     */
    function getKeyAtIndex(uint256 index) external view returns (string memory) {
        require(index < recordKeys.length, "Index out of bounds");
        return recordKeys[index];
    }

    /**
     * @notice Check interface support
     * @param interfaceId The interface identifier
     * @return True if the interface is supported
     */
    function supportsInterface(bytes4 interfaceId) external pure returns (bool) {
        return interfaceId == type(IS2SRecordsModule).interfaceId ||
               interfaceId == 0x01ffc9a7; // ERC165
    }
}

/**
 * @title S2SRecordsModuleFactory
 * @notice Factory for deploying S2SRecordsModule instances
 */
contract S2SRecordsModuleFactory {
    event ModuleCreated(address indexed safe, address indexed module);
    
    /**
     * @notice Create a new S2SRecordsModule for a Safe
     * @param safe The Safe address that will own the module
     * @return module The address of the created module
     */
    function createModule(address safe) external returns (address module) {
        module = address(new S2SRecordsModule(safe));
        emit ModuleCreated(safe, module);
        return module;
    }
}
</file>

<file path="protocol/contracts/docs/ens-deployment-guide.md">
# ENS Deployment Guide for Soul2Soul

This guide walks through the process of deploying and configuring the ENS infrastructure for the Soul2Soul protocol. The system uses a cross-chain approach with records stored on Base and resolved from Ethereum.

## Prerequisites

Before you begin, ensure you have:

1. An ENS domain you own (e.g., soul2soul.eth)
2. Access to both Ethereum and Base networks
3. Sufficient ETH on both networks for deployment transactions
4. API keys for block explorers if you want contract verification

Make sure your `.env` file has the following variables:

```
# Network access
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PRIVATE_KEY=your_private_key_here

# Block explorer API keys (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
```

## Deployment Process

### Step 1: Deploy ENSSubdomainRecordsContract on Base Sepolia

First, deploy the contract that will store ENS records on Base:

```bash
npx hardhat run scripts/deploy-ens-subdomain-records.ts --network baseSepolia
```

After successful deployment, you'll receive:
- Contract address
- Transaction hash
- Verification status

Export the contract address as an environment variable:

```bash
export BASE_RECORDS_ADDRESS=0x...your_contract_address...
```

### Step 2: Authorize Callers (Optional)

If you want other addresses to be able to manage ENS records:

```bash
npx hardhat run scripts/authorize-caller.ts --network baseSepolia
```

You'll be prompted to enter:
- The address to authorize
- Whether to authorize or revoke authorization

### Step 3: Test Records on Base

Test that your records contract works correctly:

```bash
npx hardhat run scripts/test-ens-subdomain-records.ts --network baseSepolia
```

This will:
- Set test records for `test.soul2soul.eth`
- Verify records can be read
- Test batch operations

### Step 4: Deploy DirectRPCResolver on Ethereum Sepolia

Now deploy the resolver contract on Ethereum that will use CCIP-Read to fetch records from Base:

```bash
npx hardhat run scripts/deploy-ens-resolver.ts --network sepolia
```

After deployment, save the resolver address:

```bash
export ENS_RESOLVER_ADDRESS=0x...your_resolver_address...
```

### Step 5: Set Your ENS Domain to Use the Resolver

Using the ENS app (https://app.ens.domains/):

1. Connect wallet that owns your ENS domain
2. Navigate to your domain
3. Go to "More" → "Set Resolver"
4. Enter your resolver address
5. Confirm the transaction

Alternatively, you can use our script (requires domain ownership):

```bash
npx hardhat run scripts/set-ens-resolver.ts --network sepolia
```

### Step 6: Test the Complete Setup

Test the full resolution flow:

```bash
npx hardhat run scripts/test-ens-resolution.ts --network sepolia
```

This confirms:
- Resolver is properly configured
- CCIP-Read is working correctly
- Cross-chain resolution is set up

## Managing ENS Records

### Adding New Subdomains

To add a new subdomain:

```bash
npx hardhat run scripts/add-subdomain-record.ts --network baseSepolia
```

Or use direct contract calls:

```javascript
// Get the namehash of the subdomain
const subNode = namehash("mysubdomain.soul2soul.eth");

// Set records
await ensSubdomainRecords.setAddress(subNode, "0x...");
await ensSubdomainRecords.setText(subNode, "description", "My subdomain description");
await ensSubdomainRecords.setText(subNode, "url", "https://example.com");
```

### Batch Updates

For efficiency, use batch updates when setting multiple records:

```javascript
const nodes = [namehash("sub1.soul2soul.eth"), namehash("sub2.soul2soul.eth")];
const addresses = ["0x...", "0x..."];
const keys = [
  ["description", "url"],
  ["description", "avatar", "url"]
];
const values = [
  ["First subdomain", "https://example.com"],
  ["Second subdomain", "https://example.com/avatar.png", "https://example.com/sub2"]
];

await ensSubdomainRecords.batchSetRecords(nodes, addresses, keys, values);
```

## Troubleshooting

### Common Issues

1. **Resolver not set correctly**:
   - Verify the resolver address with `ens.getResolver('soul2soul.eth')`

2. **Records not appearing**:
   - Check Base contract has records: `ensSubdomainRecords.getAddress(node)`
   - Verify RPC URLs in resolver are correct: `resolver.getRpcUrls()`

3. **Transaction errors**:
   - Ensure you're using the account that owns the contract or is authorized
   - Check gas settings for Base transactions

### Verification Failures

If contract verification fails:

```bash
npx hardhat verify --network baseSepolia CONTRACT_ADDRESS
```

## Advanced Configuration

### Custom RPC URLs

To update RPC URLs in the resolver:

```bash
npx hardhat run scripts/update-resolver-rpcs.ts --network sepolia
```

### Emergency Functions

For emergency situations:

- Clear records: `ensSubdomainRecords.clearRecords(node, keys)`
- Transfer records: `ensSubdomainRecords.emergencyTransferRecords(fromNode, toNode, keys)`

## References

- [ENS Documentation](https://docs.ens.domains/)
- [CCIP-Read Specification](https://eips.ethereum.org/EIPS/eip-3668)
- [Base Chain Documentation](https://docs.base.org/)
</file>

