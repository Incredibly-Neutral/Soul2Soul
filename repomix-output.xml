        }

        .toggle-knob::before {
          transform: rotate(45deg);
        }

        .toggle-knob::after {
          transform: rotate(-45deg);
        }

        /* Active (checked) */
        #dev-toggle:checked + .toggle-lid {
          background: var(--accent);
        }

        #dev-toggle:checked + .toggle-lid .toggle-knob {
          --icon-color: var(--accent);
