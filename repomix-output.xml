dotenv.config({ path: '../.env'});

const recordsModuleAbi = [
{
    name: "setRecord",
    type: "function",
    inputs: [
    { name: "key", type: "string" },
    { name: "value", type: "string" },
    ],
},
] as const;

const ensRecordsAbi = [
{
    name: "authorizeCaller",
    type: "function",
    inputs: [
    { name: "caller", type: "address" },
