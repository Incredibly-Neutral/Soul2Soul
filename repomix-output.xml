        <label for="dev-toggle" class="toggle-lid">
          <span class="toggle-knob"></span>
        </label>
        <span class="toggle-label">Dev mode</span>
      </span>
    `

    this.shadowRoot.querySelector('.btn-open')?.addEventListener('click', () => {
      window.open('https://basescan.org/address/' + this.value, '_blank', 'noopener,noreferrer')
    })
    
    const devToggle = this.shadowRoot?.querySelector('#dev-toggle') as HTMLInputElement;
