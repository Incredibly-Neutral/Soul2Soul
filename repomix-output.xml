    this.observable.update(current => {
      if (!current) return null;
      const { [key]: _, ...rest } = current;
      return rest;
    });
  }

  clear(): void {
    this.observable.set(null);
  }

  subscribe(listener: Listener<Record<string, OnChainRecord> | null>): () => void {
