export const paymasterAddress = (chain: string) => {
    
    switch(chain) {
        case 'BASE_SEPOLIA':
            return '    '
        case 'ARB_SEPOLIA':
            return '0x4Db923a131CF391f56875a9eF16422639EFA6d4b'
    }
