<file path="website-starter/templates/home.handlebars">
<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}
<body>
    {{> header}}
    <main>

        <section class="container medium_container flex_row ">

            {{#each collections.posts}}
                <article id="{{this.id}}" class="block" author="{{author}}">
                {{> background }}
                <div>
                <a href=".{{this.path}}">
                    <span class="date">{{formatDate this.creationDate}}</span>
                    <h3>{{this.title}}</h3>
                    <div class="author">{{authorFromAddress this.author}}</div>
                </a>
                </div>
                </article>
            {{/each}}

        </section>
      
    </main>
</body>
</html>
</file>

<file path="website-starter/templates/page.handlebars">
<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="page">
    {{> header}}
    <main>
        {{> background }}

        <section id="page_container" class="container small_container">
          
            <article class="page">   
                <h2>{{title}}</h2> 
               
                {{{extract_images content}}}          
            </article>
        
        </section>
    </main>
</body>
</html>
</file>

<file path="website-starter/templates/post.handlebars">
<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="blog">
    {{> header}}
    <main>
        {{> background }}

        <section id="blog_container" class="container small_container">
          
            <article class="blog" id="{{this.id}}" author="{{author}}">  
                
                <h2>{{title}}</h2> 
                <div class="author">{{author}}</div> 
                <span class='date'>{{formatDate creationDate}}</span>
                
               
                {{{extract_images content}}}          
            </article>
        
        </section>
    </main>
</body>
</html>
</file>

