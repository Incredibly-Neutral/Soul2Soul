    // ── Typed data signing (delegates to EOA, needed by neutralpress) ──

  signTypedData(
    domain: any,
    types: any,
    message: any,
  ): Promise<`0x${string}`> {
    // Signer is an EOA — signTypedData is available
    return this.signer.signTypedData({
      domain,
      types,
      message,
      primaryType: Object.keys(types)[0] || "",
    });
  }

  asTypedDataSigner() {
    const self = this;
    return {
      signTypedData(
        domain: Record<string, unknown>,
        types: Record<string, { name: string; type: string }[]>,
        value: Record<string, unknown>,
      ) {
        return self.signer.signTypedData({
          domain,
          types,
          message: value,
          primaryType: Object.keys(types)[0] || "",
        });
      },
      getAddress() {
        return self.signer.address;  // EOA — the actual signer of the EIP-712 message
      },
    };
  }

    // Helper function to ensure proper 0x prefixed hex string format
  private ensureHex(value: string): `0x${string}` {
    if (!value) throw new Error("Empty value provided");
    
    // Remove any existing 0x prefix and convert to lowercase
    const cleaned = value.replace(/^0x/i, '').toLowerCase();
    
    // Validate it's a valid hex string
    if (!/^[0-9a-f]*$/.test(cleaned)) {
      throw new Error(`Invalid hex string: ${value}`);
    }
    
    return `0x${cleaned}` as `0x${string}`;
  }
}
