      ` : ''}

      <div class="section">
        <div class="list_header">
          <h2 class="section-title">Active Licenses (${licenses.length})</h2>
        </div>

        ${licenses.length > 0 ? `
          <div class="table">
            <div class="table-header">ID / Title</div>
