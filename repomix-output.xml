    safeAddress: process.env.PROTOCOL_SAFE_ADDRESS!,
    });

    const apiKit = new SafeApiKit({
    chainId: 8453n,
    });

    // Create + sign + propose
    const safeTransaction = await protocolKit.createTransaction({
    transactions: transactions.map((tx) => ({
        ...tx,
        operation: OperationType.Call,
    })),
