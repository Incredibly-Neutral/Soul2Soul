class ToggleButton extends HTMLElement {

  private bool: boolean = ''
  private label: string = ''


  constructor() {
    super()
    this.attachShadow({ mode: 'open' })
    this.shadowRoot!.adoptedStyleSheets = []
  }

  static get observedAttributes() {
    return ['bool', 'label']   // ✅ already there, no change needed
  }

  attributeChangedCallback(name: string, oldValue: boolean, newValue: boolean | boolean) {
    if (oldValue === newValue) return
    if (name === 'bool') this.bool = newValue
    if (this.shadowRoot) this.render()
  }

  connectedCallback() {
    if (!this.bool) this.bool = !!this.getAttribute('bool') || false 
    if (!this.label) this.label = this.getAttribute('label') || ''   // ← add this
    this.render()
  }

  disconnectedCallback() {
  }

  private render() {
    if (!this.shadowRoot) return

    this.shadowRoot.innerHTML = `
      <style>

        :host {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
        }

        /* Dev mode X/check toggle — CodePen raubaca/BjGKde */
