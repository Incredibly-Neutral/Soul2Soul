    margin: 3rem auto 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;

    @media screen and (min-width: breakpoints.$breakpoint-medium) {
        flex-direction: row;
    }

    > img {
        max-width: 280px;           
        height: auto;
        border-radius: 52%;

        &:first-of-type {
            display: none;
            @media screen and (min-width: breakpoints.$breakpoint-medium) {
                display: block;
            }
        }
    }
}

.container.images {

    margin: 1.5rem auto 3rem auto;

    img {
        width: 100%;
        height: auto;
      
    }
}
</file>

<file path="website-starter/scss/basics/layouts.scss">
@use '../styleguide/breakpoints';

.flex_row {
    display: flex;
    
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
    flex-wrap: wrap;

    @media screen and (min-width: breakpoints.$breakpoint-medium) {
        flex-direction: row;
    }

}
</file>

<file path="website-starter/scss/basics/main.scss">
@use '../styleguide/breakpoints';
@use '../styleguide/typography';

html {
    position: relative;
    width: 100vw;
    margin: 0;
    padding: 0;
  
    font-size: 15px; // Default font size (1rem = 16px)

    @media (min-width: breakpoints.$breakpoint-small) {
        
        font-size: 12px; // Reduce the root font size (1rem = 14px)
    }

    @media (min-width: breakpoints.$breakpoint-medium) {
        
        font-size: 12px; // Reduce the root font size (1rem = 14px)
    }


    @media (min-width: breakpoints.$breakpoint-large) {
        
        font-size: 14px; // Reduce the root font size (1rem = 16px)
    }
      
      
    @media (min-width: breakpoints.$breakpoint-xlarge) {
        
        font-size: 16px; // Reduce the root font size (1rem = 14px)
    }
      
}

body {

    position: relative;
    padding: 0;
    margin: 0;
    width: 100%;
    min-height: 100vh;
  
}

main {
    position: relative;
}
</file>

<file path="website-starter/scss/styleguide/breakpoints.scss">
$breakpoint-small: 576px;
$breakpoint-medium: 768px;
$breakpoint-large: 992px;
$breakpoint-xlarge: 1200px;
</file>

