    eq: (a: any, b: any) => a === b,
    not: (a: any) => !a,
    and: (...args: any[]) => args.slice(0, -1).every(Boolean),
    or: (...args: any[]) => args.slice(0, -1).some(Boolean),
    // Add more helpers as needed
