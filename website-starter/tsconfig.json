{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@s2s/renderer/*": ["../protocol/actions/src/renderer/*"],
      "@s2s/render/*": ["../protocol/actions/src/render/*"]
    }
  },
  "include": ["./scripts", "./data"]
}
