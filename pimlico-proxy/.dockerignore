# The local install is a symlink to a checkout outside this directory; it must
# never enter the build context. Dependencies are installed inside the image.
node_modules

# Build output is produced in the builder stage, never copied in from the host.
dist

# Secrets. The operator's .env is passed at run time (compose `env_file`), never
# baked into a layer -- and image layers are readable by anyone who has the image.
.env
.env.*

# Dev-only: the image ships compiled JavaScript, and tests are not part of it.
test
*.tsbuildinfo

# Packaging files: read by Docker and Compose themselves, not needed in a layer.
Dockerfile
.dockerignore
compose.yaml

# Documentation: nothing at run time reads it.
README.md

# VCS metadata: large, and never useful inside an image.
.git
.gitignore

# Editor/OS noise.
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
