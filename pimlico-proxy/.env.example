# Pimlico proxy configuration. Copy to .env and fill in real values.
# Empty values are treated as unset for optional variables.

# --- Upstream (required) ---

# Pimlico API key. Secret: never commit the real value.
PIMLICO_API_KEY=pim_your_key_here
# Sponsorship policy injected into every sponsored user operation.
PIMLICO_SPONSORSHIP_POLICY_ID=sp_your_policy_id_here
# Base URL of the Pimlico API; https required except for localhost.
PIMLICO_BASE_URL=https://api.pimlico.io
# Upstream request timeout in milliseconds (integer >= 1000).
UPSTREAM_TIMEOUT_MS=15000

# --- Chain and call allowlist (required) ---

# Comma-separated chain ids this proxy serves, e.g. 84532,10.
ALLOWED_CHAIN_IDS=84532
# Comma-separated allowed targets: address:selector (all chains) or chainId:address:selector.
# Selector "*" allows any selector on that target.
ALLOWED_CALLS=84532:0x0000000000000000000000000000000000000000:0xa9059cbb
# Comma-separated contract factories allowed for deployment (optional, default none).
ALLOWED_FACTORIES=
# Allow user operations that send native value (optional, default false).
ALLOW_NATIVE_VALUE=false
# Allow deployment user operations (optional, default false).
ALLOW_DEPLOYMENT=false

# --- HTTP surface ---

# Comma-separated bare origins allowed by CORS, no trailing slash, no wildcard.
CORS_ORIGINS=https://app.example.com
# Listen port (optional, default 8080).
PORT=8080
# Requests per minute per user (optional, default 60).
RATE_LIMIT_PER_MINUTE=60
# Trust X-Forwarded-For for client IPs (optional, default true).
TRUST_PROXY=true
# Comma-separated JSON-RPC methods to forward (optional, default is the built-in list).
ALLOWED_METHODS=eth_chainId,eth_sendUserOperation

# --- Auth ---

# "jwt" (default) or "none"; "none" is refused when NODE_ENV=production.
AUTH_MODE=jwt
# HMAC-SHA256 secret for session tokens, at least 32 characters. Secret: keep out of git.
AUTH_JWT_SECRET=your_32_character_or_longer_secret_here
# Expected "iss" claim (optional; checked when set).
AUTH_JWT_ISSUER=https://auth.example.com
# Expected "aud" claim, string or array member (optional; checked when set).
AUTH_JWT_AUDIENCE=pimlico-proxy
