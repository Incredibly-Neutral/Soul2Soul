{
  "name": "s2s-records-safe-app",
  "version": "1.0.0",
  "description": "Safe app for managing S2S Records Module",
  "type": "module",
  "scripts": {
    "build": "pnpm test && tsc && vite build && pnpm sass",
    "verify": "pnpm build && pnpm test:e2e",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:component": "vitest run --project component --reporter=verbose",
    "test:e2e": "playwright test",
    "clean": "rimraf dist",
    "qa": "node qa/qa.mjs",
    "deploy": "./deploy.sh",
    "sass": "sass ./src/styles/main.scss ./dist/main.css"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.6.0",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "dotenv": "^17.2.2",
    "playwright": "1.63.0",
    "rimraf": "^5.0.1",
    "sass": "^1.100.0",
    "typescript": "^7.0.2",
    "vite": "6.4.4",
    "vitest": "4.1.9"
  },
  "keywords": [
    "safe",
    "ethereum",
    "web3",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "dependencies": {
    "@helia/unixfs": "^8.0.3",
    "@phosphor-icons/webcomponents": "2.1.5",
    "@ipld/car": "^5.4.6",
    "@s2s/soul2soul-shared": "workspace:*",
    "@safe-global/safe-apps-provider": "0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "filecoin-pin": "^1.0.1",
    "lit": "^3.3.3",
    "multiformats": "^13.4.1",
    "path": "^0.12.7",
    "terser": "^5.44.0",
    "viem": "^2.48.4"
  }
}
