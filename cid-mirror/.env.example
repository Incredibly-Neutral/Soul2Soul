# ── cid-mirror .env example ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# Publication URL: an ENS name (e.g. xxx.soul2soul.eth) or a bare CID.
PUBLICATION_URL=

# L1 RPC URL — Ethereum MAINNET (chainId 1).
# Used ONLY for the s2s ENS controller discovery leg
# (registry.nameWrapper -> ownerOf -> parentDomainController).
# The root CID is NOT read from mainnet.
L1_RPC_URL=

# L2 RPC URL — BASE mainnet (chainId 8453).
# s2s stores the root CID as the text record `contenthash_wrapped` on the
# ensRecords records contract on Base L2; this is the chain the CID is read from.
L2_RPC_URL=

# Optional: override the s2s ensRecords records contract address.
# When unset, the records contract is discovered at runtime via the s2s ENS
# flow (controller -> configModule -> getRecords('ens_records')) on L1+L2.
# RECORDS_CONTRACT=

# Kubo (IPFS) RPC API base URL.
IPFS_API_URL=http://127.0.0.1:5001

# HTTP port for the mirror API (default: 3000).
PORT=3000

# Optional: auto-refresh interval in milliseconds.
# If unset, only manual POST /api/refresh triggers a re-mirror.
# REFRESH_INTERVAL_MS=3600000

# Optional: kubo RPC Authorization header value (e.g. "Bearer <token>").
# IPFS_API_AUTH=
