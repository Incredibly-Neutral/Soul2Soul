{
  "name": "lastmile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Soul2Soul last-mile: serve a .com only from what its .eth ENS contenthash points to, verified on the server (Phase 1).",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.4.0",
    "viem": "^2.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "rollup": "4.64.5"
  }
}
