{
  "name": "@s2s/author-cli",
  "version": "0.1.0",
  "description": "Headless author CLI for soul2soul — upload / preview / publish / revoke / new. Powers the Neovim plugin (machine-friendly output).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "s2s": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@s2s/soul2soul-shared": "workspace:*",
    "dotenv": "^16.6.1",
    "permissionless": "^0.2.57",
    "viem": "^2.48.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
