{
  "name": "@s2s/monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "deploy-group": "tsx --require dotenv/config protocol/scripts/lit/deploy-group.ts",
    "inspect-group": "tsx --require dotenv/config protocol/scripts/lit/inspect-group.ts",
    "actions:build": "node protocol/scripts/lit/build-actions.cjs",
    "actions:add": "tsx --require dotenv/config protocol/scripts/lit/add-action.ts",
    "actions:swap": "tsx --require dotenv/config protocol/scripts/lit/swap-action.ts",
    "refresh-key": "tsx --require dotenv/config protocol/scripts/lit/refresh-key.ts",
    "update-protocol": "tsx --require dotenv/config protocol/scripts/lit/update-protocol.ts",
    "deploy-action": "bash -c 'pnpm actions:build && tsx --require dotenv/config protocol/scripts/lit/swap-action.ts $1 && tsx --require dotenv/config protocol/scripts/lit/update-protocol.ts' deploy-action",
    "plugins": "pnpm -C shared run build && pnpm -C 0xobsidian run build && pnpm -C neutralpress run build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "@ensdomains/buffer": "npm:buffer@^6.0.3"
    }
  },
  "dependencies": {
    "repomix": "^1.14.1"
  }
}
