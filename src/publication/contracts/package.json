{
  "name": "@s2s/publication-contracts",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./abis/*": {
      "types": "./generated/abis/*.ts",
      "default": "./generated/abis/*.ts"
    },
    "./artifacts/*": {
      "types": "./generated/artifacts/*.ts",
      "default": "./generated/artifacts/*.ts"
    },
    "./abis/S2SRecordsModuleFactory": {
      "types": "./legacy/S2SRecordsModuleFactory.ts",
      "default": "./legacy/S2SRecordsModuleFactory.ts"
    },
    "./artifacts/S2SRecordsModuleFactory": {
      "types": "./legacy/S2SRecordsModuleFactory.artifact.ts",
      "default": "./legacy/S2SRecordsModuleFactory.artifact.ts"
    }
  },
  "files": [
    "index.ts",
    "legacy",
    "generated/abis",
    "src"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "export": "ldenv rocketh-export -e @@MODE @@",
    "deploy:factory": "tsx scripts/deploy-factory.ts",
    "deploy:impl": "tsx scripts/deploy-implementation.ts",
    "deploy:pubfac": "tsx scripts/deploy-publication-factory.ts",
    "deploy:pub": "tsx scripts/update-impl.ts",
    "deploy:pubimpl": "tsx scripts/deploy-publication-implementation.ts",
    "verify": "tsx scripts/verify-pub.ts",
    "clean": "rm -rf artifacts cache generated",
    "set:impl": "tsx scripts/set-implementation.ts",
    "upgrade:module": "tsx scripts/upgrade-module.ts",
    "upgrade:pub": "tsx scripts/upgrade-publication.ts",
    "register:module": "tsx scripts/register-module.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@safe-global/api-kit": "^3.0.2",
    "@safe-global/protocol-kit": "^6.1.2",
    "dotenv": "^16.6.1",
    "viem": "^2.46.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-keystore": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.8",
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "@types/node": "^20.19.31",
    "hardhat": "^3.1.8",
    "hardhat-deploy": "^2.0.0",
    "ldenv": "^0.3.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
