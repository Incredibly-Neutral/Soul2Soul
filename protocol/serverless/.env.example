# ── Environment ──

# IPFS gateway for fetching actions and content (default)
IPFS_GATEWAY=https://neutralpress.mypinata.cloud

# Action execution timeout (milliseconds)
ACTION_TIMEOUT_MS=30000

# Bun HTTP server port
PORT=8000

# bun runtime settings (can override)
# BUN_RUNTIME_TIMEOUT_MS=60000

# ── IPFS settings ──
# IPFS gateway URL used by the runner to fetch actions
# Format: https://gateway.example.com

# ── Storage provider credentials (dual-provider: Pinata + Filebase) ──
# Active provider is selected per-package via settings/env vars.
# Filebase (default):
# VITE_FILEBASE_TOKEN=your-filebase-access-token
# VITE_FILEBASE_BUCKET=s2s
# Pinata:
# PINATA_JWT=your-pinata-jwt
# PINATA_GATEWAY=https://neutralpress.mypinata.cloud
# PIN_PROVIDER=pinata   # set to 'pinata' to switch from the default 'filebase'

# ── Docker settings ──
# docker-compose run --rm server bun run server.ts
