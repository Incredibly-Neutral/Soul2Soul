{
  "name": "@s2s/protocol",
  "version": "1.0.0",
  "description": "Smart contract protocol",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "compile:prod": "hardhat compile --build-profile production",
    "test": "hardhat test",
    "deploy:dev": "ldenv -d localhost hardhat --network @@MODE deploy @@",
    "deploy:all": "hardhat deploy --network @@MODE @@",
    "deploy:factories": "hardhat deploy --tags S2SRecordsModuleFactory,S2SPublicationModuleFactory --network @@MODE @@",
    "deploy:ens": "hardhat deploy --tags ENS --network @@MODE @@",
    "deploy:upgrade": "hardhat deploy --tags upgrade --network @@MODE @@",
    "verify": "ldenv rocketh-verify -e @@MODE @@",
    "export": "ldenv rocketh-export -e @@MODE @@",
    "check": "tsx scripts/check-module.ts",
    "update": "pnpm compile && tsx ./scripts/pkp-update.ts",
    "mint": "pnpm compile && hardhat run scripts/pkp-mint.ts",
    "deposit": "hardhat run scripts/deposit-litkey.ts",
    "delegate": "tsx ./scripts/delegate-lit-user.ts",
    "fund": "tsx ./scripts/fund-myself.ts",
    "upload-config": "tsx scripts/upload-config.ts",
    "upload-index": "tsx scripts/upload-index.ts",
    "root-dag": "tsx scripts/root-dag.ts",
    "build": "node scripts/build-action.js",
    "action": "tsx scripts/test-main-action.ts",
    "lens-app-create": "tsx ./scripts/lens.create-app.ts",
    "lens-app-fetch": "tsx ./scripts/lens.fetch-app.ts",
    "lens-feed-create": "tsx ./scripts/lens.create-feed.ts",
    "lens-feed-fetch": "tsx ./scripts/lens.fetch-feed.ts",
    "lens-query-posts": "tsx ./scripts/lens.query-posts.ts",
    "filecoin:setup-key": "tsx ./scripts/filecoin/setup-session-key.ts",
    "filecoin:setup-payment": "tsx ./scripts/filecoin/setup-payment.ts",
    "filecoin:check-status": "tsx ./scripts/filecoin/check-status.ts",
    "filecoin:fund-account": "tsx ./scripts/filecoin/fund-account.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-keystore": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.8",
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@rocketh/deploy": "^0.19.1",
    "@rocketh/doc": "^0.19.3",
    "@rocketh/export": "^0.19.3",
    "@rocketh/node": "^0.19.3",
    "@rocketh/proxy": "^0.19.1",
    "@rocketh/read-execute": "^0.19.0",
    "@rocketh/router": "^0.19.1",
    "@rocketh/signer": "^0.19.0",
    "@rocketh/verifier": "^0.19.3",
    "@rocketh/viem": "^0.19.0",
    "@types/node": "^20.19.31",
    "cross-var": "^1.1.0",
    "dotenv": "^16.6.1",
    "earl": "^2.0.0",
    "hardhat": "^3.1.8",
    "hardhat-deploy": "^2.0.0",
    "ldenv": "^0.3.16",
    "prettier": "^3.8.0",
    "prettier-plugin-solidity": "^2.2.1",
    "rocketh": "^0.19.4",
    "slippy": "^0.3.1",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.46.2",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@filoz/synapse-core": "^0.7.0",
    "@filoz/synapse-sdk": "^1.0.1",
    "@ensdomains/content-hash": "^3.0.0",
    "@ensdomains/ens-contracts": "^1.6.2",
    "@ensdomains/eth-ens-namehash": "^2.0.15",
    "@ipld/dag-pb": "^4.1.5",
    "@lens-chain/sdk": "^1.0.3",
    "@lens-chain/storage-client": "^1.0.6",
    "@lens-protocol/client": "0.0.0-canary-20250430134539",
    "@lens-protocol/metadata": "^2.1.0",
    "@lens-protocol/react": "^2.3.2",
    "@lit-protocol/auth": "^8.2.3",
    "@lit-protocol/auth-helpers": "^8.2.1",
    "@lit-protocol/constants": "^8.0.8",
    "@lit-protocol/lit-client": "^8.3.1",
    "@lit-protocol/networks": "8.4.1",
    "@s2s/soul2soul-shared": "workspace:*",
    "@safe-global/api-kit": "^3.0.2",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/safe-contracts": "1.4.1-2",
    "@safe-global/safe-core-sdk-types": "^5.1.0",
    "@safe-global/types-kit": "^3.0.0",
    "axios": "^1.13.4",
    "cids": "^1.1.9",
    "esbuild": "^0.25.12",
    "ethers": "^6.16.0",
    "ethers5": "npm:ethers@^5.8.0",
    "form-data": "^4.0.5",
    "html-entities": "^2.6.0",
    "ipfs-unixfs": "^12.0.0",
    "multibase": "^4.0.6",
    "multiformats": "^13.4.2",
    "multihashing-async": "^2.1.4",
    "typestub-ipfs-only-hash": "^4.0.0",
    "zod": "^3.25.76"
  }
}
